# Copy to .env — never commit real secrets.

# Supabase Postgres — use Dashboard "Connect" to copy the right URI:
# - Direct (db.<ref>.supabase.co:5432) for long-running Node; IPv6-first.
# - Or session pooler (*.pooler.supabase.com:5432, user postgres.<ref>) for IPv4-friendly.
# See: https://supabase.com/docs/guides/database/connecting-to-postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase project URL + JWT verification (Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Symmetric JWT secret (legacy HS256 projects). Leave empty if your project uses JWKS / ES256 / RS256 —
# the API will then verify tokens against https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads

# Stripe (optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:3000
