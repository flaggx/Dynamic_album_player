# Supabase (Auth + data) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (sb_publishable_…) or legacy anon JWT — either works with @supabase/ssr
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Legacy name still supported if publishable is unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: service role for Stripe routes and admin-style DB writes (never expose to the browser)
# Vercel: add under Environment Variables for Production/Preview only (not NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional duplicate of project URL for server code; defaults to NEXT_PUBLIC_SUPABASE_URL if unset
# SUPABASE_URL=https://your-project-ref.supabase.co

# Stripe (server routes under /api/premium/*)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Optional: Auth0-style app URL for return links (if your app still uses it)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: if DB rows still have legacy Express paths like `/uploads/file.mp3`, set the public origin
# that serves those files (no trailing slash), e.g. https://api.example.com or http://localhost:3001
# NEXT_PUBLIC_LEGACY_UPLOADS_BASE_URL=http://localhost:3001
